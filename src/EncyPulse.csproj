<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EncyPulse</RootNamespace>
    <AssemblyName>EncyPulse</AssemblyName>
    <Version>0.3.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutDir>bin\$(Configuration)\</OutDir>
    <!-- SmtpClient is flagged as legacy; it is still the dependency-free way to send mail on Windows. -->
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>

  <!-- Release output is packed into the store package as-is: keep it flat. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- ENCY 3 runs on .NET 10; the extension is a library loaded into that process. -->
    <PackageReference Include="EncySoftware.CAMAPI.Sdk.Net" Version="3.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Update="EncyPulse.settings.json" CopyToOutputDirectory="Always" />
    <None Update="package.info.json" CopyToOutputDirectory="Always" />
    <None Update="readme.md" CopyToOutputDirectory="Always" />
    <None Include="screenshots\*.png;screenshots\*.jpg;screenshots\*.jpeg;screenshots\*.gif;screenshots\*.webp"
          CopyToOutputDirectory="Always" Link="%(Filename)%(Extension)" />
    <!-- Real ENCY viewport used on the workstation screen of the demo illustration (embedded) -->
    <Resource Include="media\part.png" />
    <!-- Optional onboarding recording; see media\README.md. Shipped flat next to the DLL. -->
    <None Include="media\welcome.mp4" CopyToOutputDirectory="Always" Link="welcome.mp4" Condition="Exists('media\welcome.mp4')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EncyPulse.Tests" />
  </ItemGroup>

  <!-- The SDK's transitive packages copy doc xmls into the output via their own AfterTargets="Build"
       hooks. PackReady depends on Build so it runs after them and sweeps the junk out.
       Build with: dotnet build src -c Release -t:PackReady -->
  <Target Name="PackReady" DependsOnTargets="Build">
    <ItemGroup>
      <_SdkJunk Include="$(OutDir)*.xml" Exclude="$(OutDir)$(AssemblyName).xml" />
      <_SdkJunk Include="$(OutDir)*.stbuildresult.json" />
    </ItemGroup>
    <Delete Files="@(_SdkJunk)" />
    <Message Importance="high" Text="PackReady: output cleaned for packing -> $(OutDir)" />
  </Target>
</Project>
